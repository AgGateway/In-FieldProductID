                      "$ref" : "#/definitions/token"
                    }, {
                      "description" : "Gross Weight of the shipping container",
                      "examples" : [ "GrossWeight" ]
                    } ]
                  },
                  "unitCode" : {
                    "allOf" : [ {
                      "$ref" : "#/definitions/token"
                    }, {
                      "description" : "Unit of measure of the gross weight",
                      "examples" : [ "LB" ]
                    } ]
                  }
                }
              }
            }
